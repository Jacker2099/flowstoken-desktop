# FlowsToken Desktop packaging / dev overrides (copy to .env.opensource or export in shell)
# Do NOT put API keys here.

VETTA_CLOUD_ENABLED=false
VETTA_DISABLE_BUILTIN_MARKETPLACE=1
VETTA_OPEN_MARKETPLACE_REPOSITORY=
VETTA_PRODUCT_NAME=FlowsToken
VETTA_APP_ID=com.flowstoken.desktop
VETTA_EXECUTABLE_NAME=FlowsToken
VETTA_UPDATE_PROVIDER=generic
VETTA_UPDATE_URL=https://www.flowstoken.com/downloads/desktop
# Isolate local data from a stock Vetta install:
# VETTA_HOME=/Users/you/.flowstoken-desktop
# NEVER for production/smoke that should match real users:
# VETTA_DEV_AUTO_APPROVE_ACTIONS=0
